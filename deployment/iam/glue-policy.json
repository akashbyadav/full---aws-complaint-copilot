{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:851725469799:workgroup/complaint-copilot"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetPartitions",
        "glue:GetPartition",
        "glue:BatchGetPartition"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:851725469799:catalog",
        "arn:aws:glue:us-east-1:851725469799:database/complaint_copilot",
        "arn:aws:glue:us-east-1:851725469799:table/complaint_copilot/complaint*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/raw/*",
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/curated/*",
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/knowledge/*",
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/state/*",
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/quarantine/*",
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/code/*",
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/athena-results/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::complaint-copilot-851725469799-us-east-1/knowledge/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "bedrock:StartIngestionJob",
        "bedrock:GetIngestionJob",
        "bedrock:ListIngestionJobs",
        "bedrock:Retrieve"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:851725469799:knowledge-base/*"
      ]
    },
    {
      "Sid": "FindProjectKnowledgeBase",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListKnowledgeBases"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "FindProjectDataSource",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListDataSources"
      ],
      "Resource": "arn:aws:bedrock:us-east-1:851725469799:knowledge-base/*"
    }
  ]
}
